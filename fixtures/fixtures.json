{
  "package": "mixtime",
  "package_version": "0.4.0",
  "r_version": "4.6.1",
  "calendar": "cal_gregorian",
  "epoch": "1970-01-01",
  "cases": [
    {
      "name": "day_to_month",
      "from": {
        "unit": "day",
        "n": 1
      },
      "to": {
        "unit": "month",
        "n": 1
      },
      "input": [-1, 0, 1, 59, 60, 90, 365, 366, 19723, 19782, 20700, 31.25],
      "expected": {
        "div": [-1, 0, 0, 2, 2, 3, 12, 12, 648, 649, 680, 1],
        "mod": [30, 0, 1, 0, 1, 0, 0, 1, 0, 28, 3, 0.25]
      }
    },
    {
      "name": "day_to_quarter",
      "from": {
        "unit": "day",
        "n": 1
      },
      "to": {
        "unit": "month",
        "n": 3
      },
      "input": [-1, 0, 1, 59, 60, 90, 365, 366, 19723, 19782, 20700, 31.25],
      "expected": {
        "div": [-1, 0, 0, 0, 0, 1, 4, 4, 216, 216, 226, 0],
        "mod": [91, 0, 1, 59, 60, 0, 0, 1, 0, 59, 65, 31.25]
      }
    },
    {
      "name": "day_to_year",
      "from": {
        "unit": "day",
        "n": 1
      },
      "to": {
        "unit": "year",
        "n": 1
      },
      "input": [-1, 0, 1, 59, 60, 90, 365, 366, 19723, 19782, 20700, 31.25],
      "expected": {
        "div": [-1, 0, 0, 0, 0, 0, 1, 1, 54, 54, 56, 0],
        "mod": [364, 0, 1, 59, 60, 90, 0, 1, 0, 59, 246, 31.25]
      }
    },
    {
      "name": "month_to_day",
      "from": {
        "unit": "month",
        "n": 1
      },
      "to": {
        "unit": "day",
        "n": 1
      },
      "input": [-1, 0, 1, 12, 13, 600, 660.5],
      "expected": {
        "div": [-31, 0, 31, 365, 396, 18262, 20104.5],
        "mod": [0]
      }
    },
    {
      "name": "bimonth_to_day",
      "from": {
        "unit": "month",
        "n": 2
      },
      "to": {
        "unit": "day",
        "n": 1
      },
      "input": [-1, 0, 1, 12, 13, 600, 660.5],
      "expected": {
        "div": [-61, 0, 59, 730, 790, 36525, 40208],
        "mod": [0]
      }
    },
    {
      "name": "year_to_day",
      "from": {
        "unit": "year",
        "n": 1
      },
      "to": {
        "unit": "day",
        "n": 1
      },
      "input": [-1, 0, 1, 54, 55, 56.5],
      "expected": {
        "div": [-365, 0, 365, 19723, 20089, 20636.5],
        "mod": [0]
      }
    }
  ]
}
